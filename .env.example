# Local settings for the Automatic Audit app. Copy to `.env` (git-ignored) and fill in the values.
# On Render the same names are set on the service in the dashboard; `.env` is never read there.
# There is no shared password any more: people sign in with accounts (python manage.py create-user).

# Local development only. `disabled` skips the sign-in screen and records nothing.
# Never use this mode on Render: the app refuses to start there without AUTH_MODE=required.
AUTH_MODE=disabled
DATA_DIR=.data

# Named in the prompts sent to the model provider and in the page title.
ORGANIZATION=Company Name
AUDIENCE=customers and users

# Model provider keys. The app uses one provider per run, chosen in the sidebar.
ANTHROPIC_API_KEY=sk-...
OPENAI_API_KEY=sk-...

# Optional: email finished workbooks to the user. Leave these blank to switch the "Email results to me"
# option off. Example values are for SendGrid; for Gmail use smtp.gmail.com with an App Password.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxxxx...
EMAIL_FROM=audit-noreply@yourcompany.com
